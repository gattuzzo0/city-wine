# Frontend (Vercel / local). Anon key is public; never put SERVICE_ROLE here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Empty locally (Next rewrites /api → http://127.0.0.1:8000). Required in Vercel Preview + Production.
NEXT_PUBLIC_BACKEND_URL=city-wine-api.vercel.app

# Vercel frontend project: Root Directory = frontend
# Vercel API project: Root Directory = backend
